{
  "name": "barakah-lead-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply barakah-leads --remote",
    "db:migrate:local": "wrangler d1 migrations apply barakah-leads --local",
    "leads": "node scripts/leads.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250924.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.40.0"
  }
}
